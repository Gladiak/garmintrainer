{$APP_DOMAIN} {
  encode zstd gzip
  header X-Content-Type-Options nosniff
  redir /phpmyadmin /phpmyadmin/ 308
  handle_path /phpmyadmin/* {
    reverse_proxy phpmyadmin:80 {
      header_up X-Forwarded-For {remote_host}
    }
  }
  handle {
    reverse_proxy app:3000 {
      header_up X-Forwarded-For {remote_host}
    }
  }
}
